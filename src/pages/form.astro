---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { actions } from "astro:actions";

const pageTitle = "Formulario de pruebas";

const result = Astro.getActionResult(actions.newClient);

if (result && !result.error) {
  return Astro.redirect("/");
}

if (result?.error) {
  console.log(result.error);
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <BaseLayout pageTitle={pageTitle}>
      <p>Formulario de aprendizaje Astro.</p>
      <form
        method="POST"
        action={actions.newClient}
        style="display: flex; flex-direction: column; gap: 14px; background: #14151C; border: 1px solid #292B36; border-radius:16px; padding: clamp(22px, 3vw, 32px);"
      >
        <label
          for="nombre"
          style="font-size: 13.5px; font-weight: 500; color: #C5C7D4;"
          >Nombre</label
        >
        <input
          id="nombre"
          name="nombre"
          type="text"
          required="required"
          placeholder="¿Cómo te llamas?"
          style="background: #0E0F14; border: 1.5px solid #292B36; border-radius: 10px; padding: 13px 15px; font-size: 15.5px; color: #F5F6FC; font-family: 'Space Grotesk', sans-serif; outline: none;"
          style-focus="border-color:#5555FF;"
        />
        <label
          for="email"
          style="font-size: 13.5px; font-weight: 500; color: #C5C7D4; margin-top: 6px;"
          >Email</label
        >
        <input
          id="email"
          name="email"
          type="email"
          required="required"
          placeholder="tu@empresa.com"
          style="background: #0E0F14; border: 1.5px solid #292B36; border-radius: 10px; padding: 13px 15px; font-size: 15.5px; color: #F5F6FC; font-family: 'Space Grotesk', sans-serif; outline: none;"
          style-focus="border-color: #5555FF;"
        />
        <label
          for="descripcion"
          style="font-size: 13.5px; font-weight: 500; color: #C5C7D4; margin-top: 6px;"
          >Descripción</label
        >
        <textarea
          id="descripcion"
          name="descripcion"
          rows="4"
          required="required"
          placeholder="Qué quieres…"
          style="background: #0E0F14; border: 1.5px solid #292B36; border-radius: 10px; padding: 13px 15px; font-size: 15.5px; color: #F5F6FC; font-family: 'Space Grotesk', sans-serif; outline: none; resize: vertical;"
          style-focus="border-color: #5555FF;"></textarea>
        <button
          type="submit"
          style="background: #5555FF; color: #FFFFFF; font-weight: 600; font-size: 16.5px; font-family: 'Space Grotesk', sans-serif; padding: 15px 24px; border: none; border-radius: 999px; cursor: pointer; margin-top: 10px;"
          style-hover="transform: translateY(-2px); filter: brightness(1.06);"
          >Enviar</button
        >
      </form>
    </BaseLayout>
  </body>
</html>
